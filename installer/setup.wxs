<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <!--
    File Converter per-user installer (MSI).
    Installs to %LocalAppData%\Programs\File Converter — no admin rights needed.
    Start Menu + Desktop shortcuts, standard uninstall via Windows Settings.
    Build: build-installer.bat (publishes the app first, then runs WiX).
  -->

  <Package Name="File Converter"
           Manufacturer="Refat"
           Version="1.0.0"
           UpgradeCode="8BE3177F-A102-4E00-ABC7-F687CDA564AE"
           Scope="perUser"
           Language="1033"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of File Converter is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="..\assets\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <!-- install folder: %LocalAppData%\Programs\File Converter -->
    <StandardDirectory Id="PerUserProgramFilesFolder">
      <Directory Id="INSTALLFOLDER" Name="File Converter" />
    </StandardDirectory>

    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="0F7A3B39-F275-4B5D-B2EF-FB0777E5403B">
        <File Id="FileConverterExe" Source="..\publish\FileConverter.exe" />

        <!-- per-user components use an HKCU registry value as KeyPath -->
        <RegistryValue Root="HKCU" Key="Software\FileConverter"
                       Name="Installed" Type="integer" Value="1" KeyPath="yes" />

        <Shortcut Id="StartMenuShortcut"
                  Directory="ProgramMenuFolder"
                  Name="File Converter"
                  Description="Convert Office, PDF and image files"
                  Target="[#FileConverterExe]"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />

        <Shortcut Id="DesktopShortcut"
                  Directory="DesktopFolder"
                  Name="File Converter"
                  Description="Convert Office, PDF and image files"
                  Target="[#FileConverterExe]"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
      </Component>
    </ComponentGroup>

  </Package>
</Wix>
